# ReturnOps AI v1.1 — template ONLY, no live values or secrets.
# Read these from `supabase status` (local) or Supabase dashboard Connect (hosted).
# Browser-side (safe to expose ONLY these two publishable values):
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# FastAPI/worker, server-only:
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# Supabase Postgres connection string, not Supabase API URL.
# Obtain direct or session-pooler URL from Dashboard > Connect.
DATABASE_URL=postgresql+psycopg://<database-user>:<password>@<db-host>:5432/postgres
APP_ENV=development
REFUND_MODE=simulation_only
TIMEZONE=Asia/Ho_Chi_Minh
LLM_PROVIDER=<provider>
LLM_MODEL=<pinned-model-id>
LLM_API_KEY=<server-only-if-needed>
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ENABLE_EXTERNAL_TELEMETRY=false
# NEVER use SUPABASE_SECRET_KEY/service_role, database password, or LLM_API_KEY in NEXT_PUBLIC_*.
